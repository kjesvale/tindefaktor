{
    "name": "tindefaktor",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "bun test",
        "lint": "oxlint",
        "format": "prettier --write .",
        "verify": "bun run scripts/verify.ts"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 100,
        "arrowParens": "avoid"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "maplibre-gl": "^6.6.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "oxlint": "^1.71.0",
        "prettier": "^3.9.5",
        "typescript": "~6.0.2",
        "vite": "^8.1.1"
    }
}
